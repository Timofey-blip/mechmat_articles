<!DOCTYPE html>
<html>
  <head>
    <title>Mechmat Articles</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background: #f5f5f5;
      }
      
      .navbar {
        background: #2c3e50;
        color: white;
        padding: 15px 20px;
        margin-bottom: 20px;
      }
      
      .navbar h1 {
        margin: 0 0 10px 0;
        font-size: 24px;
      }
      
      .navbar a {
        color: #3498db;
        text-decoration: none;
        margin-right: 15px;
        font-weight: bold;
      }
      
      .navbar a:hover {
        color: #2ecc71;
        text-decoration: underline;
      }
      
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
      }
      
      .notice {
        background: #2ecc71;
        color: white;
        padding: 10px 15px;
        border-radius: 5px;
        margin-bottom: 15px;
      }
      
      .alert {
        background: #e74c3c;
        color: white;
        padding: 10px 15px;
        border-radius: 5px;
        margin-bottom: 15px;
      }
      
      .button {
        display: inline-block;
        background: #3498db;
        color: white;
        padding: 8px 15px;
        text-decoration: none;
        border-radius: 5px;
        margin-right: 10px;
      }
      
      .button:hover {
        background: #2980b9;
      }
    </style>
  </head>

  <body>
    <div class="navbar">
      <div class="container">
        <h1>📚 Мехмат Статьи</h1>
        <nav>
          <%= link_to "🏠 Главная", articles_path %>
          <%= link_to "📝 Создать статью", new_article_path %>
          <%= link_to "🔍 Поиск", search_path %>
          <%= link_to "📂 Категории", categories_path %>
        </nav>
      </div>
    </div>

    <div class="container">
      <% if notice %>
        <p class="notice"><%= notice %></p>
      <% end %>

      <% if alert %>
        <p class="alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>