<h2> Комментарии (<%= @article.comments.count %>)</h2>

<% if @article.comments.any? %>
  <% @article.comments.each do |comment| %>
    <div style="margin: 10px 0; padding: 10px; background: #f9f9f9; border-left: 3px solid #007bff;">
      <p><strong><%= comment.author %>:</strong> <%= comment.body %></p>
      <small><%= comment.created_at.strftime("%d.%m.%Y %H:%M") %></small>
      <%= button_to "🗑️ Удалить", article_comment_path(@article, comment), method: :delete, data: { confirm: "Удалить комментарий?" } %>
    </div>
  <% end %>
<% else %>
  <p>Пока нет комментариев. Будьте первым!</p>
<% end %>

<h3> Добавить комментарий</h3>
<%= form_with model: [[id5654450|@article], @comment] do |f| %>
  <p>
    <%= f.label :author, "Ваше имя" %>

    <%= f.text_field :author, required: true %>
  </p>
  
  <p>
    <%= f.label :body, "Комментарий" %>

    <%= f.text_area :body, rows: 3, required: true %>

  </p>
  
  <p>
    <%= f.submit "Отправить комментарий" %>
  </p>
<% end %>