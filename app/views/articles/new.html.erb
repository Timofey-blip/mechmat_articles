<h1>📝 Новая статья</h1>

<%= form_with model: @article do |f| %>
  <% if @article.errors.any? %>
    <div style="color: red; background: #ffe6e6; padding: 15px; border-radius: 5px; margin-bottom: 20px;">
      <h2><%= pluralize(@article.errors.count, "ошибка") %> не позволяет сохранить статью:</h2>
      <ul>
        <% @article.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= f.label :title, "Заголовок" %><br>
    <%= f.text_field :title, required: true, size: 50 %>
  </p>

  <p>
    <%= f.label :author, "Автор" %><br>
    <%= f.text_field :author, required: true %>
  </p>

  <p>
    <%= f.label :category_id, "Категория" %><br>
    <%= f.collection_select :category_id, Category.all, :id, :name, prompt: "Выберите категорию", required: true %>
  </p>

  <p>
    <%= f.label :content, "Содержание статьи" %><br>
    <%= f.text_area :content, rows: 15, required: true %>
  </p>

  <p>
    <%= f.submit "Создать статью" %>
  </p>
<% end %>

<%= link_to "← Назад к статьям", articles_path %>